{
  "buildCommand": "echo 'Build complete'",
  "devCommand": "vercel dev",
  "functions": {
    "api/**/*.js": {
      "runtime": "nodejs18.x"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "env": [
    "STRIPE_SECRET_KEY",
    "STRIPE_WEBHOOK_SECRET",
    "BREVO_API_KEY",
    "APIFY_TOKEN",
    "CLAUDE_API_KEY",
    "SUPABASE_URL",
    "SUPABASE_ANON_KEY",
    "GA_MEASUREMENT_ID",
    "NODE_ENV"
  ]
}
